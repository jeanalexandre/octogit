{
  "name": "octogit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "cargo build -q -p octogit-app --example octogit-bridge && node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js --mode web --strictPort",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "gen:bindings": "cargo run -q -p octogit-app --example gen-bindings",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings && eslint .",
    "format": "cargo fmt --all && prettier --write .",
    "format:check": "cargo fmt --all --check && prettier --check .",
    "test": "cargo test --workspace && vitest run",
    "e2e": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test --trace off",
    "audit:deps": "cargo audit && pnpm audit",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.71.0",
    "@tauri-apps/api": "^2.12.4"
  }
}
