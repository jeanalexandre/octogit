{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Octogit",
  "version": "0.1.0",
  "identifier": "dev.octogit.app",
  "build": {
    "beforeDevCommand": "pnpm gen:bindings && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm check && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Octogit",
        "width": 1500,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" }
  }
}
